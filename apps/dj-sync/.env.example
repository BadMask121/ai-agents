# Telegram bot lane — leave TELEGRAM_BOT_TOKEN empty to run only the MCP lane.
TELEGRAM_BOT_TOKEN=
DJ_SYNC_ALLOWED_USER_IDS=

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional — enables AI rung in the matcher and the natural-language parser.
ANTHROPIC_API_KEY=

# MCP lane ([mcp] enabled = true). The secret path is the credential:
# ChatGPT connects to https://<host>/<MCP_SECRET_PATH>/mcp. `openssl rand -hex 24`
MCP_SECRET_PATH=

# Optional — enables POST /api/downloads for the iOS Shortcut. `openssl rand -hex 24`
SHORTCUT_API_KEY=

# Cloud lane ([cloud] enabled = true): must equal the Worker's AGENT_TOKEN secret.
CLOUD_AGENT_TOKEN=

RUST_LOG=dj_sync=info,teloxide=warn
